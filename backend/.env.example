# Copy to .env for local development. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://bodp:bodp_dev_pw@localhost:5432/bodp
DATABASE_URL_SYNC=postgresql+psycopg://bodp:bodp_dev_pw@localhost:5432/bodp

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET_KEY=dev-only-insecure-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

CORS_ORIGINS=["http://localhost:3000"]

STORAGE_VPS_ENDPOINT_URL=http://localhost:9000
STORAGE_VPS_ACCESS_KEY=bodp_minio_admin
STORAGE_VPS_SECRET_KEY=change-me-minio-secret
STORAGE_VPS_BUCKET=bodp-vps
STORAGE_VPS_REGION=us-east-1

STORAGE_CLOUD_ENDPOINT_URL=
STORAGE_CLOUD_ACCESS_KEY=
STORAGE_CLOUD_SECRET_KEY=
STORAGE_CLOUD_BUCKET=
STORAGE_CLOUD_REGION=us-east-1

MAX_UPLOAD_SIZE_MB=5000

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@bodp.example.org
EMAIL_FROM_NAME=BODP Platform
