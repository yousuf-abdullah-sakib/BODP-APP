# syntax=docker/dockerfile:1
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# See Dockerfile (prod) for why libexpat1/libgdal-dev/libgeos-c1v5/libproj-dev
# are needed — rasterio's bundled GDAL requires them at runtime, not just build time.
# postgresql-client: pg_dump/pg_restore for Phase 10.3's real backup task
# (worker/tasks/backups.py, celery-worker runs this Dockerfile) — the
# base image's default repo candidate matches the postgis/postgis:17-3.5
# server major version exactly (confirmed via apt-cache policy), so no
# pinned third-party apt repo is needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    curl \
    libexpat1 \
    libgdal-dev \
    libgeos-c1v5 \
    libproj-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[dev]"

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
