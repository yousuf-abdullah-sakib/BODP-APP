# Copy to .env.prod on the VPS and fill in real values. Never commit the
# real file. Referenced by docker-compose.prod.yml.

FRONTEND_URL=https://bodp.example.org
BACKEND_URL=https://bodp.example.org
CORS_ORIGINS=["https://bodp.example.org"]

POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE

JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_VALUE_MIN_32_CHARS

MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE
STORAGE_VPS_BUCKET=bodp-vps

# Cloud storage tier — filled in once a provider is selected (Master Plan §5).
STORAGE_CLOUD_ENDPOINT_URL=
STORAGE_CLOUD_ACCESS_KEY=
STORAGE_CLOUD_SECRET_KEY=
STORAGE_CLOUD_BUCKET=

# Any SMTP-compatible provider works (Brevo, Postmark, SES, Resend, ...).
# Brevo free tier: https://app.brevo.com -> SMTP & API -> SMTP tab.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@bodp.example.org
EMAIL_FROM_NAME=BODP Platform
